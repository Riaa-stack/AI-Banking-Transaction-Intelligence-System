# ============================================================
# Backend Environment Configuration Template
# Copy this file to .env and configure your local settings:
#   cp .env.example .env  (or copy on Windows)
# ============================================================

# ── Database (PostgreSQL) ──────────────────────────────────
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ai_banking_db

# ── Security & Authentication ──────────────────────────────
SECRET_KEY=replace_with_a_secure_random_flask_secret_key
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars

# ── AI APIs (Google Gemini) ────────────────────────────────
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: OpenAI ───────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── File Uploads ───────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800                   # 50 MB

# ── Mail Configuration (Optional - for Email alerts) ──────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
